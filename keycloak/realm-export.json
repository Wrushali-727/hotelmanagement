{
  "realm": "hotel-management",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "ADMIN" },
      { "name": "GUEST" },
      { "name": "HOTEL_STAFF" }
    ]
  },
  "clients": [
    {
      "clientId": "hotel-management-web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:8080", "+"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "firstName": "System",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "guest",
      "email": "guest@example.com",
      "firstName": "Demo",
      "lastName": "Guest",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "guest123", "temporary": false }],
      "realmRoles": ["GUEST"]
    },
    {
      "username": "staff",
      "email": "staff@example.com",
      "firstName": "Hotel",
      "lastName": "Staff",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "staff123", "temporary": false }],
      "realmRoles": ["HOTEL_STAFF"]
    }
  ]
}
